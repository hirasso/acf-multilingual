{
  "name": "hirasso/acf-multilingual",
  "description": "An experimental plugin for building multilingual websites using WordPress and Advanced Custom Fields 🌀",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "authors": [
    {
      "name": "Rasso Hilber",
      "email": "mail@rassohilber.com"
    }
  ],
  "autoload": {
    "psr-4": {
      "Hirasso\\ACFML\\": "src"
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "repositories": [
    {
      "name": "wp-packages",
      "type": "composer",
      "url": "https://repo.wp-packages.org"
    }
  ],
  "require": {
    "php": "~8.2 || ~8.3 || ~8.4 || ~8.5"
  },
  "conflict": {
    "doctrine/instantiator": ">=2.1.0"
  },
  "require-dev": {
    "laravel/pint": "^1.25",
    "pestphp/pest": "^1.23",
    "php-stubs/wp-cli-stubs": "^2.12",
    "phpstan/extension-installer": "^1.4",
    "phpstan/phpstan": "^2.1",
    "roots/wordpress": "^7.1",
    "symfony/var-dumper": "^7.3",
    "wp-phpunit/wp-phpunit": "^7.1",
    "wp-plugin/advanced-custom-fields": "^6.6",
    "wp-plugin/classic-editor": "^1.6",
    "wp-theme/twentytwentyfive": "^1.3",
    "yoast/wp-test-utils": "^1.2"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "composer/installers": true,
      "pestphp/pest-plugin": true,
      "phpstan/extension-installer": true,
      "roots/wordpress-core-installer": true
    },
    "platform": {
      "php": "8.2"
    }
  },
  "extra": {
    "wordpress-install-dir": "vendor/.wp/core",
    "installer-paths": {
      "vendor/.wp/plugins/{$name}/": [
        "type:wordpress-plugin"
      ],
      "vendor/.wp/themes/{$name}/": [
        "type:wordpress-theme"
      ]
    }
  },
  "scripts": {
    "post-install-cmd": "tools/sync-wp-env-core.sh",
    "post-update-cmd": "tools/sync-wp-env-core.sh",
    "analyse": "phpstan analyse --memory-limit=2G",
    "format": "pint",
    "test": "pest --no-coverage"
  }
}
