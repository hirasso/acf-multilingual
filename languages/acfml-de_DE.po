#: src/Admin.php:263
msgid "ACF Multilingual requires the plugin %s to be installed and activated."
msgstr "ACF Multilingual benötigt das Plugin %s."

#. translators: 1: Link to the permalink settings
#: src/Admin.php:282
msgid ""
"Pretty permalinks need to be activated. Please go to your %s and select e.g. "
"'Post name'."
msgstr ""
"'Pretty Permalinks' sind nicht aktiviert. Bitte gehe zu den %s und wähle "
