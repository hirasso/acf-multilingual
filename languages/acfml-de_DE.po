#. Plugin Name of the plugin
#: acf-multilingual.php
msgid "ACF Multilingual"
msgstr "ACF Multilingual"

#. Description of the plugin
#: acf-multilingual.php
msgid ""
"An experimental plugin for building multilingual websites using WordPress "
"and Advanced Custom Fields 🌀"
msgstr ""
"Ein experimentelles Plugin um mehrsprachige Websites mit WordPress und "
"Advanced Custom Fields zu bauen 🌀"

