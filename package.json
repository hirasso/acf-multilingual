{
  "name": "acf-multilingual",
  "author": "Rasso Hilber",
  "license": "GPL-2.0-or-later",
  "version": "3.2.6",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "preinstall": "git config core.hooksPath .githooks",
    "make-pot": "tools/make-pot.sh",
    "version": "pnpm changeset version && bin/cli.js version:patch",
    "env": "wp-env",
    "env:test": "wp-env --config .wp-env.test.json",
    "launch": "open $(wp-env status --json | jq -r '.urls.development')",
    "wp": "wp-env run cli wp",
    "composer": "wp-env run cli --env-cwd=wp-content/plugins/acf-multilingual composer",
    "format": "prettier --write 'resources/*.{js,css}' && composer format",
    "analyse": "tsc --noEmit --project ./jsconfig.json && composer analyse",
    "test": "wp-env --config .wp-env.test.json run cli --env-cwd=wp-content/plugins/acf-multilingual composer test"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "@types/jquery": "^3.5.33",
    "@wordpress/env": "^11.16.0",
    "fast-glob": "^3.3.3",
    "lint-staged": "^16.2.6",
    "picocolors": "^1.1.1",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3"
  }
}
